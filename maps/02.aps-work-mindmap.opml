  <body>
    <outline text="APS Method v2.0.0-method"
      _note="Portable OS for agentic delivery. SoT: agentic-pm-standard/md/. Import in MindNode: File → Import. Catalog ids (10–27, 30–52) live in H1/YAML — file ordinals (#) differ per folder (see naming-standard).">

      <outline text="North star and law"
        _note="When AI reads, classifies, and drafts under published policy, people own exceptions, sampling, and the rule—not every ticket in the inbox.">
        <outline text="Immutable law — AI reads/classifies/drafts; GREEN under policy; RED to sender"
          _note="md/06.laws/01.immutable-law.md"/>
        <outline text="Exception-based DoR — not a PM mailbox"
          _note="md/00.start/01.story-spine.md"/>
        <outline text="SoT over nucleus — docs + tracker + CI beat chat/agent"
          _note="P4 · md/06.laws/02.delivery-planes.md"/>
      </outline>

      <outline text="Start here (reading path)">
        <outline text="01 Story spine — 15 min"
          _note="md/00.start/01.story-spine.md"/>
        <outline text="02 At a glance — one-page method"
          _note="md/00.start/02.at-a-glance.md"/>
        <outline text="00 Start index"
          _note="md/00.start/00.index.md"/>
        <outline text="09 Portfolio lens · 10 Presentation kit"
          _note="md/00.start/09.portfolio-lens.md · 10.presentation-kit.md"/>
        <outline text="HTML wiki (generated)"
          _note="html/index.html — cd scripts &amp;&amp; bun run build"/>
      </outline>

      <outline text="Principles P1–P7"
        _note="md/00.start/03.principles.md · md/06.laws/00.index.md">
        <outline text="P1 Exception-based readiness"
          _note="Green only under policy; else typed exception path"/>
        <outline text="P2 Classify before commit"
          _note="No Ready without class + commit_path"/>
        <outline text="P3 Sender–PM–Pod triad"
          _note="Red→sender; yellow→PM; pod pulls Ready"/>
        <outline text="P4 SoT over nucleus"
          _note="Docs + tracker + CI beat chat/agent"/>
        <outline text="P5 Plane integrity A / B / B′ / C"
          _note="Govern · build · QC execute · ship (human)"/>
        <outline text="P6 Stage-gated evidence"
          _note="Eight product stages; RED before GREEN; Done=log"/>
        <outline text="P7 Executable knowledge"
          _note="Checklists and matrices, not prose-only process"/>
      </outline>

      <outline text="Lifecycle and rhythm"
        _note="md/00.start/04.lifecycle-and-planes.md · md/01.flow/08.lifecycle/">
        <outline text="Outside-in funnel"
          _note="noise → intake → classify → commit path → Ready → factory → ship → audit"/>
        <outline text="Portfolio rhythm"
          _note="feature increment → wave cut → slice (one primary service/app)"/>
        <outline text="01.entry — funnel outside-in"
          _note="md/01.flow/08.lifecycle/01.entry/"/>
        <outline text="02.increment — bootstrap · wave go/no-go"
          _note="md/01.flow/08.lifecycle/02.increment/"/>
        <outline text="03.slice — pre-flight · go/no-go · BIP/FIP"
          _note="md/01.flow/08.lifecycle/03.slice/"/>
        <outline text="Eight product stages (+ B′ + HIL)"
          _note="md/09.lookup/01.meta/02.lifecycle-eight-stages.md">
          <outline text="1 Requirements"/>
          <outline text="2 Analysis (US · AC · case catalog)"/>
          <outline text="3 QC design (matrix · tiers)"/>
          <outline text="4 API and interface"/>
          <outline text="5 Data design"/>
          <outline text="6 BIP/FIP + WBS readiness"/>
          <outline text="7 Test spec (RED)"/>
          <outline text="8 Implement (RED→GREEN)"/>
          <outline text="B′ QC execute (after qualified DEV)"
            _note="Plane B′ — not a ninth product stage"/>
          <outline text="9 HIL and delivery closure"
            _note="Human ship only — plane C"/>
        </outline>
      </outline>

      <outline text="Governance planes and signals"
        _note="md/06.laws/02.delivery-planes.md · md/03.factory/01.core/">
        <outline text="Plane A — govern and Ready"
          _note="intake / docs-only — never In Progress"/>
        <outline text="Plane B — build and verify"
          _note="dev-runtime — never Story Done"/>
        <outline text="Plane B′ — QC matrix execute"
          _note="qc-runtime after qualified DEV Done"/>
        <outline text="Plane C — ship (human only)"
          _note="PR merge · Story Done — agent default none"/>
        <outline text="RED / GREEN loop"
          _note="md/03.factory/01.core/02.red-green-loop.md"/>
        <outline text="Trust ladder phases"
          _note="md/01.flow/07.trust-ladder-phases.md"/>
        <outline text="Agent factory — verify · HIL · no agent Done"
          _note="md/03.factory/03.agent-factory.md"/>
      </outline>

